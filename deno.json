{
  "tasks": {
    "dev": "deno run --watch --env-file --allow-all src/main.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1",
    "@std/yaml": "jsr:@std/yaml",
    "hono": "jsr:@hono/hono@^4.6.0",
    "hono/cors": "jsr:@hono/hono@^4.6.0/cors",
    "hono/http-exception": "jsr:@hono/hono@^4.6.0/http-exception",
    "telegraf": "npm:telegraf@^3.23.0"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"]
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": true,
    "lineWidth": 120,
    "useBraces": "always"
  },
  "version": "5.0.0"
}
